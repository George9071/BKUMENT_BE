# Default normalize
* text=auto

# Source code => LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.groovy text eol=lf

*.py text eol=lf
*.pyi text eol=lf

*.js text eol=lf
*.jsx text eol=lf
